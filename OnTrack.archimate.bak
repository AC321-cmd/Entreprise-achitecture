  <folder name="Strategy" id="id-1647a507808e4ba280727753daaf1e8f" type="strategy">
    <element xsi:type="archimate:CourseOfAction" name="Staged growth over three years" id="id-33fa1aed4be745e4b2a0d8a7fb8d6b6d">
      <documentation>Four stages: parcel bundling, recipient profiling, delivery optimisation, then the offer for carriers and webshops.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Parcel bundling" id="id-88350a62271d4d8f868f0b9803bb42d3">
      <documentation>Stage 1</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Recipient profiling" id="id-67615cc392854c379a99c5c970049f60">
      <documentation>Stage 2</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Delivery optimisation" id="id-9df778363c8348e6a8661f44f21cd419">
      <documentation>Stage 3</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Carrier and webshop partnering" id="id-8b77c28c079f4cb7a199e81217d508c5">
      <documentation>Stage 4</documentation>
    </element>
    <element xsi:type="archimate:Resource" name="Carrier connectors" id="id-6467ba3403c54878a02eb36a192e33c0"/>
    <element xsi:type="archimate:Resource" name="Recipient profiles" id="id-b1d31bdcb1394c428177b05dcee252ba"/>
    <element xsi:type="archimate:Resource" name="Parcel data" id="id-70e39c04e9f34625a1a6bf51b6fdca71"/>
  </folder>
  <folder name="Business" id="id-b993831b291c45b78edb2843bd35fa84" type="business"/>
