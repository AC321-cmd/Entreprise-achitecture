  <folder name="Technology &amp; Physical" id="id-56486b53869f4602a51de523a43551b6" type="technology"/>
  <folder name="Motivation" id="id-0a4ef090121445b8a29689ce64ffeeff" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Recipient" id="id-5802c5b75b2c414485b922ee886ae1e4">
      <documentation>Person who receives parcels from many webshops and carriers.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Carrier and webshop" id="id-821220975ef84d658cd566d20e16d040">
      <documentation>Pays for OnTrack through a subscription or a fee per optimised parcel.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Growing online parcel volume" id="id-b3a196d4ba974bdb8ced3b613f2ca185"/>
    <element xsi:type="archimate:Assessment" name="Missed deliveries and scattered parcel apps" id="id-57c4df24448842c894da166d2141eca0"/>
    <element xsi:type="archimate:Goal" name="Effortless parcel delivery for recipients" id="id-b102d0d051c847d9af7c233f6ea58a14"/>
    <element xsi:type="archimate:Goal" name="Lower cost per delivered parcel" id="id-7dcc48c331a64b37b227b2bc1393dde9"/>
    <element xsi:type="archimate:Outcome" name="Fewer missed first attempts" id="id-a1995f7447244ffbb8ee206ebfcd24cf"/>
    <element xsi:type="archimate:Requirement" name="Carrier-neutral overview of all parcels" id="id-907c3d7b90514f4385399aea94dabfad"/>
    <element xsi:type="archimate:Requirement" name="Delivery optimisation based on recipient profile" id="id-b05e25b59e9d46ec82a8eef19bd25c01"/>
    <element xsi:type="archimate:Principle" name="Privacy by design: opt-in profile" id="id-88f311933a444d1282786a33b330a350"/>
  </folder>
