    <element xsi:type="archimate:BusinessProcess" name="Record and manage consent" id="id-b6a2f68e7d334e0ca2971e6095b409a1">
      <documentation>Ask explicit opt-in per data use, store it, let the recipient view or withdraw it.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Recipient" id="id-20ed777fc93841f5bc3824bdf69f8c3e">
      <documentation>Person who receives parcels and uses the OnTrack app.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Privacy officer" id="id-da88756cb52048a497ae25eb7a569c95">
      <documentation>Keeps the consent texts and data use GDPR-compliant and handles requests from recipients.</documentation>
