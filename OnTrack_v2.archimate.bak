    <element xsi:type="archimate:BusinessProcess" name="Onboard new recipient" id="id-2cd7d6c288554bdfa385deccc01a3181">
      <documentation>Self-service in the app: create account, link parcel e-mails, fill in delivery preferences.</documentation>
