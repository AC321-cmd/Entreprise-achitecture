    <element xsi:type="archimate:BusinessObject" name="Consent record" id="id-ca58aa1e3b1e40ff9d25b0da8560d6dc">
      <documentation>What the recipient agreed to, when, and for which data use.</documentation>
    </element>
    <element xsi:type="archimate:Contract" name="Carrier API terms of use" id="id-0ee7540a3fc44939ace4ad1287a1c783">
      <documentation>Conditions under which OnTrack may read carrier parcel data.</documentation>
