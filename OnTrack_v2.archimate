      <property key="UC1 strategic priority" value="High"/>
      <property key="UC2 strategic profile" value="Innovate"/>
      <property key="UC5 fit-gap at 2 years" value="Partial gap"/>
    </element>
    <element xsi:type="archimate:Capability" name="Carrier and webshop partnering" id="id-8b77c28c079f4cb7a199e81217d508c5">
      <documentation>Stage 4</documentation>
      <property key="UC1 strategic priority" value="Medium"/>
      <property key="UC2 strategic profile" value="Differentiate on output"/>
      <property key="UC5 fit-gap at 2 years" value="Large gap"/>
    </element>
