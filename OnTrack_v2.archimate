  </folder>
  <folder name="Technology &amp; Physical" id="id-56486b53869f4602a51de523a43551b6" type="technology">
    <element xsi:type="archimate:Node" name="Cloud platform" id="id-1f0809a2c600440db71a1c5a3ba2bdd1"/>
  </folder>
  <folder name="Motivation" id="id-0a4ef090121445b8a29689ce64ffeeff" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Recipient" id="id-5802c5b75b2c414485b922ee886ae1e4">
      <documentation>Person who receives parcels from many webshops and carriers.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Carrier and webshop" id="id-821220975ef84d658cd566d20e16d040">
      <documentation>Pays for OnTrack through a subscription or a fee per optimised parcel.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Growing online parcel volume" id="id-b3a196d4ba974bdb8ced3b613f2ca185"/>
    <element xsi:type="archimate:Assessment" name="Missed deliveries and scattered parcel apps" id="id-57c4df24448842c894da166d2141eca0"/>
    <element xsi:type="archimate:Goal" name="Effortless parcel delivery for recipients" id="id-b102d0d051c847d9af7c233f6ea58a14"/>
    <element xsi:type="archimate:Goal" name="Lower cost per delivered parcel" id="id-7dcc48c331a64b37b227b2bc1393dde9"/>
    <element xsi:type="archimate:Outcome" name="Fewer missed first attempts" id="id-a1995f7447244ffbb8ee206ebfcd24cf"/>
    <element xsi:type="archimate:Requirement" name="Carrier-neutral overview of all parcels" id="id-907c3d7b90514f4385399aea94dabfad"/>
    <element xsi:type="archimate:Requirement" name="Delivery optimisation based on recipient profile" id="id-b05e25b59e9d46ec82a8eef19bd25c01"/>
    <element xsi:type="archimate:Principle" name="Privacy by design: opt-in profile" id="id-88f311933a444d1282786a33b330a350"/>
    <element xsi:type="archimate:Outcome" name="Prototype shows parcels of several carriers" id="id-c8bbf03e7c84455a87f1d71caec7a74d"/>
    <element xsi:type="archimate:Outcome" name="Parcel overview live for Belgian pilot users" id="id-44fd76b8097545e79e961da4386f493c"/>
    <element xsi:type="archimate:Outcome" name="Recipient profiles collected with opt-in" id="id-ba0db5a531234045a4c346efc5ca9558"/>
    <element xsi:type="archimate:Outcome" name="Delivery recommendation live for Belgian users" id="id-b74e441bf6574e60a0fb87e78917db3e"/>
    <element xsi:type="archimate:Outcome" name="Offer for carriers and webshops live in the Benelux" id="id-977fe932f8dc409eb08db66a9a6d1749"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-c05d0808347a4dfa8fbbe3df663b963c" type="implementation_migration">
    <element xsi:type="archimate:Plateau" name="3 months: prototype" id="id-99a5e834cc53418e82c2133febf2f3f8">
      <documentation>Prototype that shows the parcels of several carriers in one overview.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="6 months: Belgian launch" id="id-635e8fa9d356493ba52c9390a027b0e6">
      <documentation>Bundling and tracking live for Belgian pilot users.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="1 year: recipient profiles" id="id-e57e38db6eb941418606a179cbf210e7">
      <documentation>Opt-in recipient profile live and filled by the first users.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="2 years: delivery optimisation" id="id-a04a2e2c93e84a79b3b1ac775fc6070f">
      <documentation>Delivery recommendation (home or pickup point) live for the Belgian users.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="3 years: Benelux offer" id="id-7d3977c3fe6e437d8084d2d5ca3471b6">
      <documentation>Offer for carriers and webshops live; standard parcel app in the Benelux.</documentation>
    </element>
    <element xsi:type="archimate:Plateau" name="Today: scattered parcel apps" id="id-64b8911325f7461985eb5a48c1f73a05">
      <documentation>Each carrier and webshop has its own app, tracking page and notifications.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Gap 1: bundling and profiles" id="id-30a9d52df875487fb83126d64bbd7dd2">
      <documentation>Missing: carrier connectors, parcel app, opt-in recipient profiles.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Gap 2: delivery optimisation" id="id-d9e0c0f6ffe7400ebe341d60167c64ee">
      <documentation>Missing: decision model, delivery recommendation, outcome measurement.</documentation>
    </element>
    <element xsi:type="archimate:Gap" name="Gap 3: partner offer and Benelux" id="id-0ba4117f91ee4608ad27be0ddf350337">
      <documentation>Missing: partner onboarding, checkout integration, billing, other countries.</documentation>
    </element>
    <element xsi:type="archimate:ImplementationEvent" name="Seed funding secured" id="id-36150ae107144a57bd64e14524a1f565"/>
    <element xsi:type="archimate:WorkPackage" name="OnTrack build-up programme" id="id-8f71c755fa42460c866e86f98246bd22">
      <documentation>Programme with four projects over three years.</documentation>
    </element>
    <element xsi:type="archimate:WorkPackage" name="Parcel bundling project" id="id-853b6d304aa64cd2896208746fe17f92">
      <documentation>Timing: 0 to 6 months</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="Bundled parcel app operational" id="id-b7e57704b3c64fb6993ca2c880d1fbc7"/>
    <element xsi:type="archimate:WorkPackage" name="Recipient profiling project" id="id-fa6c5cc72d594479815452c4fbbd5913">
      <documentation>Timing: 6 months to 1 year</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="Opt-in recipient profiles collected" id="id-30f767d756a54c738436cd29b40a0a65"/>
    <element xsi:type="archimate:WorkPackage" name="Delivery optimisation project" id="id-a0b840067ec5436b9d7a149c89c6586c">
      <documentation>Timing: 1 to 2 years</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="Delivery recommendation live" id="id-7e96d127cbda4b2e82f45254493ebb10"/>
    <element xsi:type="archimate:WorkPackage" name="Carrier and webshop offer project" id="id-edce49856b1547d185f430a27d1aaa57">
      <documentation>Timing: 2 to 3 years</documentation>
    </element>
    <element xsi:type="archimate:Deliverable" name="Offer for carriers and webshops live" id="id-fd451c844a6b4b7ba698102eb47c02ce"/>
  </folder>
